{
  "name": "@sunnyln/lni-nodejs",
  "version": "0.1.0",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "lni_js",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "2.18.4",
    "@types/node": "24.13.1",
    "ava": "^6.4.1",
    "dotenv": "^16.4.7",
    "typescript": "5.9.3"
  },
  "ava": {
    "timeout": "3m"
  },
  "engines": {
    "node": ">=10.16"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "node scripts/build-package.cjs --release",
    "build:debug": "node scripts/build-package.cjs",
    "test": "node --test lexe-connect.test.js lexe-events.test.js helpers/lexe.test.js",
    "test:lexe": "node --test lexe-connect.test.js lexe-events.test.js helpers/lexe.test.js",
    "test:lexe-monitor": "node scripts/test-lexe-monitor.cjs",
    "check:package": "node scripts/check-package.cjs",
    "typecheck:helpers": "tsc -p tsconfig.helpers.json --noEmit",
    "typecheck": "tsc -p tsconfig.helpers.json --noEmit",
    "pack:dry-run": "node scripts/check-package.cjs",
    "test:install": "node scripts/test-install.cjs",
    "pack:platforms": "node scripts/pack-platforms.cjs",
    "prepublishOnly": "node scripts/check-package.cjs",
    "version:platforms": "napi create-npm-dir -t .",
    "check:native-deps": "node scripts/check-native-deps.cjs",
    "test:release": "node --test scripts/check-release.test.cjs"
  },
  "packageManager": "yarn@4.6.0",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./lexe": {
      "types": "./helpers/lexe.d.ts",
      "default": "./helpers/lexe.js"
    }
  },
  "description": "Native Node.js bindings for Lightning Node Interface, including Lexe Connect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightning-node-interface/lni.git",
    "directory": "bindings/lni_nodejs"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "npm/*"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "contracts.d.ts",
    "native.js",
    "generated/index.d.ts",
    "lexe-events.js",
    "lexe-connect.js",
    "lexe-connect.d.ts",
    "helpers/lexe.js",
    "helpers/lexe.d.ts",
    "lexe/package.json",
    "LEXE.md"
  ],
  "optionalDependencies": {
    "@sunnyln/lni-nodejs-linux-x64-gnu": "0.1.0"
  }
}
