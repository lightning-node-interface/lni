{
  "name": "@sunnyln/react-native-lni-lexe",
  "version": "0.2.16",
  "description": "React Native bindings for the Lexe Lightning wallet",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-lni-lexe-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "ReactNativeLexeFramework.xcframework",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!example",
    "!rust",
    "!node_modules"
  ],
  "scripts": {
    "example": "yarn workspace react-native-lni-lexe-example",
    "ubrn:ios": "IPHONEOS_DEPLOYMENT_TARGET=13.0 ubrn build ios --config ubrn.config.yaml --release --and-generate && yarn ubrn:postgenerate",
    "ubrn:android": "ubrn build android --config ubrn.config.yaml --release --and-generate && yarn ubrn:postgenerate",
    "ubrn:postgenerate": "node scripts/fix-ubrn-cmake.mjs && prettier --write src/NativeLniLexe.ts src/index.tsx && yarn verify:native-identity",
    "ubrn:clean": "rm -rf cpp/generated android/generated android/src/main/jniLibs ios/generated ReactNativeLexeFramework.xcframework src/generated src/NativeLniLexe.ts src/index.tsx",
    "build": "bob build && yarn verify:generated-identity",
    "release:prepare": "yarn ubrn:ios && yarn ubrn:android && yarn build && yarn lint && yarn typecheck && yarn verify:native && yarn verify:android",
    "release:dry-run": "yarn release:prepare && yarn pack:dry-run",
    "release:pack": "yarn release:prepare && npm pack",
    "release:public": "yarn release:prepare && yarn publish:public",
    "pack:dry-run": "npm pack --dry-run",
    "publish:public": "npm publish --access public",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepack": "yarn verify:native",
    "prepare": "yarn build",
    "verify:android": "yarn example build:android",
    "verify:generated-identity": "node scripts/verify-native-identity.mjs --generated",
    "verify:native": "node scripts/verify-native-artifacts.mjs && yarn verify:native-identity",
    "verify:native-identity": "node scripts/verify-native-identity.mjs",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightning-node-interface/lni.git"
  },
  "author": "Lightning Node Interface maintainers",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lightning-node-interface/lni/issues"
  },
  "homepage": "https://github.com/lightning-node-interface/lni#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.43.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-3",
    "uniffi-bindgen-react-native": "0.31.0-3"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ],
      "codegen"
    ]
  },
  "codegenConfig": {
    "name": "ReactNativeLexeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.reactnativelnilexe"
    },
    "includesGeneratedCode": true
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "cpp",
    "tools": [
      "eslint"
    ],
    "version": "0.63.0"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
