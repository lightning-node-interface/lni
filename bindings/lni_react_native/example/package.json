{
  "name": "lni_react_native-example",
  "version": "0.0.1",
  "private": true,
  "types": "../lib/typescript/commonjs/src/index.d.ts",
  "scripts": {
    "android": "../scripts/patch-android.sh && rnc-cli run-android",
    "ios": "rnc-cli run-ios",
    "start": "rnc-cli start",
    "adb": "adb reverse tcp:9740 tcp:9740",
    "build:android": "rnc-cli build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "rnc-cli build-ios --scheme LniReactNativeExample --mode Debug --extra-params \"-sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO\"",
    "clean:android": "cd android && ./gradlew clean && cd .."
  },
  "dependencies": {
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-dotenv": "^5.0.0",
    "react-native-fs": "^2.20.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/runtime": "^8.1.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/react": "^19.3.0",
    "react-native-builder-bob": "0.44.1"
  },
  "engines": {
    "node": ">=18"
  }
}
