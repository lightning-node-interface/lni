{
  "name": "lni_react_native",
  "version": "0.3.0",
  "description": "lni_react_native",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "LniReactNativeFramework.xcframework",
    "react-native.config.js",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!**/*.log",
    "!**/.DS_Store",
    "!rust_modules",
    "!example",
    "!node_modules",
    "!yarn.lock",
    "!package.tgz"
  ],
  "scripts": {
    "start": "yarn example start",
    "ubrn:ios": "ubrn build ios --config ubrn.config.yaml --release --and-generate && (cd example/ios && pod install)",
    "ubrn:android": "ubrn build android --config ubrn.config.yaml --release --and-generate",
    "ubrn:checkout": "ubrn checkout --config ubrn.config.yaml",
    "ubrn:clean": "rm -Rf cpp/ android/src/main/java ios/ src/Native* src/generated/ src/index.ts*",
    "example": "yarn workspace lni_react_native-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib && yarn cache clean --all && cd example && npx react-native start --reset-cache && cd ..",
    "build": "bob build",
    "prepare": "yarn build",
    "release": "release-it",
    "package": "yarn prepare && yarn pack"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightning-node-interface/lni.git"
  },
  "author": "nicktee <nicktee@email.com> (https://github.com/lightning-node-interface/lni)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lightning-node-interface/lni/issues"
  },
  "homepage": "https://github.com/lightning-node-interface/lni#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@evilmartians/lefthook": "^2.2.2",
    "@react-native-community/cli": "20.2.0",
    "@react-native/eslint-config": "^0.88.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "commitlint": "^21.2.4",
    "del-cli": "^8.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-builder-bob": "0.44.1",
    "release-it": "^21.1.2",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-native": "^0.88.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "codegen",
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNLniReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.lnireactnative"
    },
    "includesGeneratedCode": true
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "cpp",
    "version": "0.49.0"
  },
  "overrides": {
    "lodash": "4.18.1"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-6",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "resolutions": {
    "glob": "npm:14.0.3",
    "minimatch": "patch:minimatch@npm%3A11.0.4#~/.yarn/patches/minimatch-npm-11.0.4-dd1fb97a86.patch",
    "test-exclude": "npm:8.0.0",
    "basic-ftp": "npm:6.2.5",
    "@babel/eslint-parser": "npm:8.0.7"
  }
}
