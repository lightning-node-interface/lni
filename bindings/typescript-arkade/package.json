{
  "name": "@sunnyln/lni-arkade",
  "version": "0.2.24",
  "private": false,
  "description": "Optional Arkade Boltz adapter for @sunnyln/lni.",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/lightning-node-interface/lni.git",
    "directory": "bindings/typescript-arkade"
  },
  "homepage": "https://github.com/lightning-node-interface/lni/tree/master/bindings/typescript-arkade",
  "bugs": {
    "url": "https://github.com/lightning-node-interface/lni/issues"
  },
  "keywords": [
    "lightning",
    "bitcoin",
    "arkade",
    "boltz",
    "typescript"
  ],
  "engines": {
    "node": ">=22.13.0 <27"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && node scripts/build-boltz-vendor.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run clean && npm run typecheck && npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "publish:public": "npm publish --access public",
    "test:integration": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --env-file=../../crates/lni/.env ./node_modules/vitest/vitest.mjs run src/__tests__/integration/arkade-boltz.real.test.ts"
  },
  "peerDependencies": {
    "@sunnyln/lni": "^0.2.24"
  },
  "dependencies": {
    "@arkade-os/sdk": "0.5.1",
    "@scure/btc-signer": "^2.4.1"
  },
  "devDependencies": {
    "@sunnyln/lni": "file:../typescript",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "esbuild": "^0.28.2",
    "@arkade-os/boltz-swap": "^0.3.67"
  },
  "packageManager": "npm@11.14.0",
  "overrides": {
    "@arkade-os/boltz-swap": {
      "@arkade-os/sdk": "$@arkade-os/sdk",
      "@scure/btc-signer": "2.4.1"
    }
  }
}
